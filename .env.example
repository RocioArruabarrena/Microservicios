# Variables de entorno para el proyecto de microservicios

# ========== CONFIGURACIÓN GLOBAL ==========
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d
NODE_ENV=development

# ========== AUTH SERVICE ==========
# Puerto: 3000
# Variables en: auth/.env

# ========== USUARIO SERVICE ==========
# Puerto: 8001
# Rutas:
#   POST   /api/usuarios           (admin only)
#   GET    /api/usuarios           (admin only)
#   GET    /api/usuarios/{id}      (authenticated)
#   PUT    /api/usuarios/{id}      (authenticated)
#   DELETE /api/usuarios/{id}      (admin only)

MONGODB_URI=mongodb://localhost:27017/usuarios

# ========== PEDIDO SERVICE ==========
# Puerto: 8002
# Rutas:
#   POST   /api/pedidos            (authenticated)
#   GET    /api/pedidos            (authenticated)
#   GET    /api/pedidos/usuario/{id} (authenticated)
#   GET    /api/pedidos/{id}       (authenticated)
#   PUT    /api/pedidos/{id}       (authenticated)
#   DELETE /api/pedidos/{id}       (authenticated)

USUARIO_SERVICE_URL=http://localhost:8001
MONGODB_URI=mongodb://localhost:27017/pedidos

# ========== USUARIOS PRE-CARGADOS ==========
# Admin (en Auth Service):
#   Email: admin@example.com
#   Password: admin123
#   Role: admin
